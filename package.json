{
  "name": "growthos",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently -k \"npm run dev --workspace @growthos/api\" \"npm run dev --workspace @growthos/web\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:openapi": "tsx apps/api/src/scripts/generate-openapi.ts",
    "migrate:indexes": "npm run migrate:indexes --workspace @growthos/api",
    "check:openapi": "npm run check:openapi --workspace @growthos/api",
    "check:rewrite": "npm run check:rewrite --workspace @growthos/web",
    "e2e:api": "tsx apps/api/src/scripts/e2e-server.ts",
    "lint": "tsc -b packages/contracts apps/api apps/web",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/contracts apps/api apps/web"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "concurrently": "9.2.1",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "supertest": "7.2.2",
    "@types/node": "24.5.2",
    "@types/express": "5.0.3",
    "@types/supertest": "6.0.3",
    "@types/cookie-parser": "1.4.10",
    "mongodb-memory-server": "11.3.0"
  }
}
