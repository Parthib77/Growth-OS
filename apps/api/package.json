{
  "name": "@growthos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local-server.ts",
    "build": "npm run build --workspace @growthos/contracts && tsc -p tsconfig.build.json",
    "check:vercel-entrypoint": "node scripts/check-vercel-entrypoint.mjs",
    "start": "node dist/local-server.js",
    "seed:demo": "tsx src/scripts/seed-demo.ts",
    "migrate:indexes": "tsx src/scripts/migrate-indexes.ts",
    "check:openapi": "tsx src/scripts/check-openapi.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@growthos/contracts": "0.1.0",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "mongoose": "9.10.1",
    "@types/node": "24.5.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "typescript": "7.0.2"
  }
}
