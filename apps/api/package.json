  "dependencies": {
    "@growthos/contracts": "0.1.0",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.1.0",
    "mongoose": "9.10.1",
    "zod": "4.6.5"
